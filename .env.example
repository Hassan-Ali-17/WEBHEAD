# ==============================================================================
# WEBHEAD — Spider-Verse Developer Portfolio Environment Variables
# Author: Hassan Ali Shah
# ==============================================================================

# Supabase Realtime & Database (Required for live public chat & cloud like counter)
# Obtain these from your Supabase Project Settings -> API
# Database schema and RLS policies are available at: supabase/schema.sql
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Optional Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GOOGLE_ANALYTICS=

# Optional Cloudinary Media Storage (For picture/video file explorer albums)
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name

# Optional Spotify API Client Credentials (Playlist embeds work out-of-the-box without keys)
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
